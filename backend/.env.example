# Copy to backend/.env and fill in real values. Never commit .env.
#   cp .env.example .env

# --- Core ---
# Generate a key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# Off by default. Set to True only for local development.
DJANGO_DEBUG=False

# Comma-separated host names this site is served from
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated origins (with scheme) trusted for CSRF, e.g. https://dashboard.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- CORS: origins where the frontend (index.html) is served ---
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# --- Database ---
# sqlite (default, development) or mysql (production)
DB_ENGINE=sqlite
# For sqlite this is an optional file path; defaults to backend/db.sqlite3
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# --- HTTPS / production (only applied when DJANGO_DEBUG=False) ---
DJANGO_SECURE_SSL_REDIRECT=True
# Set to True only if a reverse proxy in front of Django sets X-Forwarded-Proto
DJANGO_BEHIND_PROXY=False
# Start small (e.g. 3600) and raise to 31536000 once HTTPS is confirmed working
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False

# Rate limit for login/register (DRF format, e.g. 10/minute)
AUTH_THROTTLE_RATE=10/minute

# --- Demo data (python manage.py seed_demo) ---
# Leave empty to have a random password generated and printed once
SEED_ADMIN_PASSWORD=
